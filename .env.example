# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# "ollama" (default, local, no key needed) or "gemini" (hosted)
LLM_BACKEND=ollama

# Only required when LLM_BACKEND=gemini. Get a free key at
# https://aistudio.google.com
GEMINI_API_KEY=

# Overrides which engine reads messy-image text, independent of
# LLM_BACKEND. "glmocr" forces GLM-OCR even when LLM_BACKEND=gemini --
# useful for testing GLM-OCR's reading quality against a hosted parsing
# backend. Leave unset (or "auto") for each backend's own default.
OCR_ENGINE=